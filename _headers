/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.pokemontcg.io https://images.scrydex.com https://archives.bulbagarden.net https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://assets.mailerlite.com https://formspree.io; form-action 'self' https://assets.mailerlite.com https://formspree.io; upgrade-insecure-requests

# Kaartdata verandert zelden; een dag cachen scheelt fors verkeer.
/sets/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Gedeelde stylesheet en script: kort cachen zodat wijzigingen snel doorkomen.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/cookie-consent.js
  Cache-Control: public, max-age=3600, must-revalidate

# Afbeeldingen en downloads zijn onveranderlijk in de praktijk.
/grading/kaarten/*
  Cache-Control: public, max-age=2592000

/downloads/*
  Cache-Control: public, max-age=604800
