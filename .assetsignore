# Bestanden die NIET mee mogen naar de publieke site.
# Wrangler deployt alles in "assets.directory" (= projectroot), ook wat in
# .gitignore staat. Dit bestand is de enige echte afscherming.

# Lokale werkdocumenten (strategie, status, SEO-plannen)
_werkdocumenten/

# Projectdocumentatie, hoort niet op de site
*.md

# Onderhoudsscripts, draaien lokaal
tools/

# MintArca white-label merk, mag nooit op startmetpokemon.nl verschijnen
MintArca-Brand-Kit/
MintArca-Brand-Kit.zip
mintarca*

# Config en repo-bestanden
# .git/ stond hier niet en werd mee gepubliceerd (startmetpokemon.nl/.git/HEAD was openbaar).
.git/
.gitattributes
.gitignore
.assetsignore
wrangler.jsonc
.wrangler/
.dev.vars*
.env*
node_modules/

# GitHub-workflows, horen niet op de site
.github/

# Worker-code en databaseschema, horen niet als bestand op de site
worker/
migrations/
